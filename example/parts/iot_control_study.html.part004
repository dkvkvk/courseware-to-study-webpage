</style>
<script>
(function(){
'use strict';
/* ====================== 公式渲染（轻量 TeX 子集） ====================== */
var SYM={alpha:'α',beta:'β',gamma:'γ',delta:'δ',Delta:'Δ',epsilon:'ε',varepsilon:'ε',zeta:'ζ',eta:'η',theta:'θ',xi:'ξ',omega:'ω',Omega:'Ω',sigma:'σ',pi:'π',phi:'φ',varphi:'φ',Phi:'Φ',tau:'τ',lambda:'λ',mu:'μ',infty:'∞',partial:'∂',cdots:'⋯',ldots:'…',prime:'′'};
var OPS={cdot:'·',times:'×',pm:'±',mp:'∓'};
var RELS={le:'≤',ge:'≥',leq:'≤',geq:'≥',ne:'≠',approx:'≈',to:'→',rightarrow:'→',Rightarrow:'⇒',Leftrightarrow:'⇔',leftrightarrow:'↔',lt:'<',gt:'>',equiv:'≡'};
var SPACES={',':'\u2009',';':'\u2005',' ':'\u00a0',quad:'\u2003',qquad:'\u2003\u2003','!':''};
var FN=['sin','cos','tan','ln','log','exp','arccos','arcsin','arctan','max','min'];
var DOTS={dot:'·',ddot:'··',dddot:'···'};
var ACC={dot:'\u0307',ddot:'\u0308',dddot:'\u20db',bar:'\u0305',hat:'\u0302'};
function esc(s){return String(s).replace(/[&<>]/g,function(c){return {'&':'&amp;','<':'&lt;','>':'&gt;'}[c];});}
function tex(src){
  var i=0,s=src;
  function ws(){while(i<s.length&&/\s/.test(s[i]))i++;}
  function seq(close){
    var out='';
    while(i<s.length){
      ws(); if(i>=s.length)break;
      if(s[i]==='}'){ if(close)i++; return out; }
      if((s[i]==='-'||s[i]==='+')&&(out===''||/(rel">[^<]*<\/span>|[(\[,]|bo">[^<]*<\/span>|dl">[(\[]<\/span>)$/.test(out))){
        out+='<span class="un">'+(s[i]==='-'?'−':'+')+'</span>'; i++; continue; }
      out+=item();
    }
    return out;
  }
  function rawGroup(){ws(); if(s[i]!=='{')return s[i++]||''; i++; var d=1,st=i; while(i<s.length){if(s[i]==='{')d++; else if(s[i]==='}'){d--; if(!d)break;} i++;} var r=s.slice(st,i); i++; return r;}
  function arg(){ws(); if(s[i]==='{'){i++; return seq(true);} return base().h;}
  function item(){
    var b=base(),sup=null,sub=null;
    for(;;){ws(); if(s[i]==='^'){i++; sup=arg();} else if(s[i]==='_'){i++; sub=arg();} else break;}
    if(b.lim&&(sup!==null||sub!==null)) return '<span class="lim">'+(sup!==null?'<span class="lim-sup">'+sup+'</span>':'')+'<span>'+b.h+'</span>'+(sub!==null?'<span class="lim-sub">'+sub+'</span>':'')+'</span>';
    if(sup!==null&&sub!==null) return b.h+'<span class="ss"><sup>'+sup+'</sup><sub>'+sub+'</sub></span>';
    return b.h+(sup!==null?'<sup>'+sup+'</sup>':'')+(sub!==null?'<sub>'+sub+'</sub>':'');
  }
  function base(){
    ws(); var c=s[i];
    if(c===undefined) return {h:''};
    if(c==='{'){i++; return {h:seq(true)};}
    if(c==='\\'){
      i++; var n='';
      if(/[A-Za-z]/.test(s[i]||'')){while(i<s.length&&/[A-Za-z]/.test(s[i]))n+=s[i++];} else n=s[i++];
      if(n==='frac'){var a=arg(),b=arg(); return {h:'<span class="frac"><span class="fn">'+a+'</span><span class="fd">'+b+'</span></span>'};}
      if(n==='sqrt'){return {h:'<span class="sqrt">√<span class="radicand">'+arg()+'</span></span>'};}
      if(n==='text'||n==='mathrm'){return {h:'<span class="tx">'+esc(rawGroup())+'</span>'};}
      if(ACC[n]){var x=arg(); if(DOTS[n]) return {h:'<span class="acc"><span class="am">'+DOTS[n]+'</span>'+x+'</span>'}; if(n==='bar') return {h:'<span style="text-decoration:overline">'+x+'</span>'}; var m=x.match(/^<i>(.)<\/i>$/); return {h:m?'<i>'+m[1]+ACC[n]+'</i>':x+ACC[n]};}
      if(n==='left'||n==='right'){var d=s[i++]; if(d==='.')return {h:''}; if(d==='\\')d=s[i++]; return {h:'<span class="dl">'+esc(d)+'</span>'};}
      if(n==='sum')return {h:'<span class="bigop">∑</span>',lim:true};
      if(n==='prod')return {h:'<span class="bigop">∏</span>',lim:true};
      if(n==='lim')return {h:'<span class="fnm">lim</span>',l